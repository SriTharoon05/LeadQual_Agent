APP_ENV=development
LLM_TIMEOUT_SECONDS=120
LOG_LEVEL=INFO
AUTH_SECRET_KEY=replace-with-at-least-32-random-bytes
AUTH_TOKEN_TTL_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
TRUSTED_HOSTS=localhost,127.0.0.1
MAX_UPLOAD_SIZE_MB=50
MAX_ROWS_PER_UPLOAD=100000
SCRAPE_MAX_HTML_BYTES=2097152
SCRAPE_MAX_TEXT_CHARS=250000
MAX_WORKERS=10
CELERY_IMPORT_QUEUE=lead_imports
CELERY_EMBED_QUEUE=lead_embeddings
CELERY_EXPORT_QUEUE=lead_exports
EXPORT_BATCH_SIZE=250
EXPORT_CACHE_SECONDS=600
EXPORT_TIMEOUT_SECONDS=1800

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_VERSION=2025-03-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
EMBED_DEPLOYMENT=text-embedding-ada-002

AZURE_SQL_SERVER=your-server.database.windows.net
AZURE_SQL_DATABASE=quality-lead
AZURE_SQL_USERNAME=
AZURE_SQL_PASSWORD=
AZURE_SQL_DRIVER=ODBC Driver 17 for SQL Server

AZURE_BLOB_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=ailead-uploads
REDIS_URL=redis://localhost:6379/0

QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=company_chunks
